# HunterFlow environment configuration (example)
# Copy to .env and adjust. NEVER commit .env or real secrets.

# --- Core secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HF_SECRET_KEY=change-me-generate-a-long-random-value

# --- First-run account ---
# If set, the first-run setup creates this account automatically.
HF_BOOTSTRAP_USERNAME=
HF_BOOTSTRAP_PASSWORD=

# --- Database / Redis (compose defaults shown) ---
HF_DATABASE_URL=postgresql+psycopg://hunterflow:hunterflow@db:5432/hunterflow
HF_REDIS_URL=redis://redis:6379/0

# --- Data directories ---
HF_DATA_DIR=/srv/hunterflow/data
HF_EVIDENCE_MAX_MB=50
HF_EVIDENCE_RETENTION_DAYS=0

# --- Tool execution ---
HF_TOOL_TIMEOUT_SECONDS=600
HF_MAX_SCAN_CONCURRENCY=1

# --- App ---
HF_ENV=production
HF_CORS_ORIGINS=

# --- Web binding ---
# 127.0.0.1 keeps the UI off the network; put a TLS reverse proxy in front.
# Set 0.0.0.0 only if you really want direct LAN access.
HF_WEB_BIND=127.0.0.1
HF_WEB_PORT=3000

# --- Monitoring (v0.2) ---
# Opt-in webhook for scheduled-scan changes (Discord/Slack incoming webhook).
HF_WEBHOOK_URL=
HF_SCHEDULER_INTERVAL_SECONDS=45
HF_MIN_SCHEDULE_MINUTES=15

# --- Team workspace (v0.3) ---
# Allow self-registration after the first (admin) account exists.
HF_ALLOW_REGISTRATION=false

# --- Optional AI assistant (v0.3) ---
# Disabled by default. Works with any OpenAI-compatible endpoint; local Ollama
# is the default. No paid service is required or configured.
HF_AI_ENABLED=false
HF_AI_BASE_URL=http://host.docker.internal:11434/v1
HF_AI_MODEL=llama3.1:8b
HF_AI_API_KEY=
